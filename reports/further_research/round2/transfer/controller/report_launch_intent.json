  "wrapper_source": "\"\"\"One authorized local report invocation; no waiting, fitting, or retry logic.\"\"\"\nimport datetime as dt\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport time\nROOT = Path('/Users/cheparukhin/ai_science_hack')\nOUT = ROOT/'reports/further_research/round2/transfer'\nCTL = OUT/'controller'\ndef now(): return dt.datetime.now(dt.timezone.utc).isoformat()\ndef digest(p): return hashlib.sha256(p.read_bytes()).hexdigest()\ndef save(p, value):\n    temp = p.with_suffix(p.suffix+'.tmp')\n    temp.write_text(json.dumps(value, indent=2)+'\\n')\n    os.replace(temp,p)\nstart=time.monotonic()\nreceipt={'schema':'round2_transfer_report_exit.1','pid':os.getpid(),'started_at_utc':now(),'cloud_spend_usd':0}\ncode=1\ntry:\n    authorization=json.loads((CTL/'report_launch_intent.json').read_text())\n    receipt['launch_intent_sha256']=digest(CTL/'report_launch_intent.json')\n    for path, expected in authorization['gate_sha256'].items():\n        if digest(ROOT/path)!=expected: raise RuntimeError('report gate changed: '+path)\n    if (OUT/'results').exists() and any((OUT/'results').iterdir()):\n        raise RuntimeError('report directory is not empty; manual reconciliation required')\n    command=[sys.executable,str(ROOT/'scripts/round2_transfer_report.py')]\n    child=subprocess.Popen(command,cwd=ROOT)\n    receipt['report_pid']=child.pid\n    receipt['command']=command\n    save(CTL/'report_status.json',{**receipt,'status':'running'})\n    code=child.wait()\n    receipt['exit_code']=code\n    if code==0:\n        p=OUT/'results/completed.json'\n        completed=json.loads(p.read_text())\n        if completed['status']!='complete' or len(completed['input_completion_hashes'])!=30:\n            raise RuntimeError('report completion is incomplete')\n        for path, expected in completed['sha256'].items():\n            if digest(OUT/'results'/path)!=expected: raise RuntimeError('report output hash changed')\n        receipt['completed_sha256']=digest(p)\n        receipt['status']='complete'\n    else:\n        receipt['status']='failed'\nexcept BaseException as exc:\n    receipt['status']='failed_or_uncertain'\n    receipt['error']=repr(exc)\n    code=1\nfinally:\n    receipt['finished_at_utc']=now()\n    receipt['elapsed_seconds']=time.monotonic()-start\n    save(CTL/'report_exit_receipt.json',receipt)\n    save(CTL/'report_status.json',receipt)\nsys.exit(code)\n",
