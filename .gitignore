foldx5_Linux_0/
demo/structures.json

# Artifact staging — the published copy of site/ lives in site/
.site_build/

# CatBoost writes training logs beside the process that fits
catboost_info/

# Phase A/B screen intermediates. Per-unit prediction arrays, ~500 MB each: the
# journal and its CSV twin hold every member's predictions for every unit, which
# the assembled and scored outputs supersede. Regenerate with
# modal_app/phase_a_experiments.py::run --resume; the small derived tables
# (scores, selection, comparisons) are the committed record.
reports/further_research/*_runs*.partial.jsonl
reports/further_research/phase_a_runs.csv
reports/further_research/phase_a_screen_assembled.csv
reports/further_research/*_members.npz

# Round-two live controller logs/locks and transient fitting journals. Final
# predictions, member tables, provenance and budget records remain versioned.
reports/further_research/round2/**/*.log
reports/further_research/round2/**/*.lock
reports/further_research/round2/**/*.tmp
reports/further_research/round2/**/*.partial.csv
reports/further_research/round2/**/members.jsonl

# Completed round-two analytical reports are evidence, unlike generic model
# output directories covered by the broad results/ rule above.
!reports/further_research/round2/**/results/
!reports/further_research/round2/**/results/**
